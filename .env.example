# Copy this file to .env and change what you need. Every value is optional.

# Port the server listens on. The map is at http://localhost:8080 after `npm start`.
PORT=8080

# Which network address the server listens on.
# 127.0.0.1 = only this computer. Use 0.0.0.0 later, when friends join over Tailscale.
HOST=127.0.0.1

# Sent with every request to a data source, so operators can see who is polling.
# DURBUN_USER_AGENT=Durbun/0.1 (personal, non-commercial)

# Free Cesium ion token (https://ion.cesium.com/signup). Turns on 3D terrain and
# Google's photorealistic 3D cities in the 3D view. Without it, the 3D view shows
# satellite imagery on a smooth globe.
CESIUM_ION_TOKEN=

# Comma-separated source ids to switch off, e.g. DISABLED_SOURCES=ibb-pharmacies
DISABLED_SOURCES=
