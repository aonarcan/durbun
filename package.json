{
  "name": "durbun",
  "version": "0.1.0",
  "private": true,
  "description": "Dürbün: a Turkey-first live map of traffic, hazards, transport and more, for personal use.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev -w @durbun/server\" \"npm:dev -w @durbun/web\"",
    "build": "npm run build -w @durbun/web",
    "start": "npm run start -w @durbun/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
